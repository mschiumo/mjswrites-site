---
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { ETSY_LISTING, ETSY_LISTING_TYPED, ETSY_SHOP } from '../lib/socials';

const POEM_PHOTOS = [
  { img: '/assets/tw-tobeloved.jpg', alt: 'a typed poem — to be loved by a poet' },
  { img: '/assets/tw-fragment.jpg', alt: 'a typed poem resting among roses' },
  { img: '/assets/tw-tryasthey.jpg', alt: 'a typed poem — try as they may' },
  { img: '/assets/tw-machine.jpg', alt: 'a vintage Smith-Corona typewriter with roses' },
];

const ETSY_GOODS = [
  {
    name: 'Hand-Typed Custom Poem',
    tag: 'Made to order',
    detail: 'An original poem, typed for you on a vintage Smith-Corona',
    price: '$50.00',
    url: ETSY_LISTING_TYPED,
    img: '/assets/etsy-custom-poem.jpg',
    alt: 'A vintage Smith-Corona typewriter with roses — custom poetry, typed by hand: a poem written only for them',
  },
  {
    name: 'Fine Art Print',
    tag: 'Print',
    detail: '175gsm fine-art paper · passepartout frame · 11″ × 14″ or 16″ × 20″',
    price: '$16.99',
    url: 'https://www.etsy.com/listing/4565254046/fine-art-prints-passepartout-paper-frame',
    img: '/assets/etsy-print.jpg',
    alt: 'A fine art print in a passepartout paper frame on a workbench, printed with the poem line "I have yet to find a fragment of you that isn\'t worth cherishing"',
  },
  {
    name: 'Cotton Canvas Tote Bag',
    tag: 'Tote',
    detail: '100% cotton canvas · 15″ × 16″',
    price: '$19.99',
    url: 'https://www.etsy.com/listing/4565224371/cotton-canvas-tote-bag',
    img: '/assets/etsy-tote.jpg',
    alt: 'Natural cotton canvas tote bag printed with the poem line "I have yet to find a fragment of you that isn\'t worth cherishing"',
  },
  {
    name: 'Scented Soy Candle',
    tag: 'Candle',
    detail: '9 oz soy wax · 50–60 hour burn · nine scents',
    price: '$22.58',
    url: 'https://www.etsy.com/listing/4565219273/scented-soy-candle-9oz',
    img: '/assets/etsy-candle.jpg',
    alt: 'A 9 oz soy candle in a glass jar, its label printed with a poem line',
  },
  {
    name: 'Ceramic Mug',
    tag: 'Mug',
    detail: 'White ceramic · 11 oz or 15 oz',
    price: '$18.99',
    url: 'https://www.etsy.com/listing/4565216855/ceramic-mug-11oz-15oz',
    img: '/assets/etsy-mug.jpg',
    alt: 'A white ceramic mug printed with the poem line "I have yet to find a fragment of you that isn\'t worth cherishing"',
  },
];

const POEM_LINES = [
  'I find something so captivating in your eyes',
  'Or, maybe, it has found me',
  "So, I'll linger here for a few seconds more",
  'As the world bustles along, as it always has',
  'And revel in the joy of a new beginning',
  'Content to be still as I uncover more of you',
  "I'll chance one last glance",
  'As you drift silently away',
  'Setting my gaze on the dwindling twilight',
  'Grateful for this moment',
  'Shared between two',
];
---
<Base
  title="The Shop — Custom Poems & Poetry Books | MJS Writes"
  description="One-of-a-kind custom poems typed on a vintage typewriter, digital poetry editions, and poetry-printed candles, mugs & tote bags. By author Michael J. Schiuma."
  active="shop"
  keywords={['custom poem', 'personalized poetry', 'typewriter poetry', 'poetry gifts', 'love poems', 'poetry books']}
>

  <header class="shop-header">
    <div class="caveat shop-hey">take a piece home</div>
    <h1>The <span class="shop-em">Shop</span></h1>
    <p>One-of-a-kind poems typed just for you, digital editions, and poetry-printed goods — candles, mugs, and totes — from my Etsy shop.</p>
  </header>

  <section class="custom-dark">
    <div class="custom-grid">
      <div class="custom-photo">
        <img src="/assets/tw-picture.jpg" alt="An original poem typed on a vintage typewriter" />
        <div class="custom-tag">typed on a real typewriter</div>
      </div>
      <div>
        <div class="eyebrow eyebrow--on-dark made-to-order">Made to order</div>
        <h2>Custom poetry, <span class="em-light">typed just for you</span></h2>
        <p class="custom-p">Tell me about a person, a moment, or a feeling, and I'll write you an original poem on a vintage typewriter — a keepsake made to be framed and kept. Perfect for weddings, anniversaries, memorials, or simply saying what's hard to say.</p>
        <a href={ETSY_LISTING_TYPED} target="_blank" rel="noopener" class="btn-light">Order on Etsy →</a>
      </div>
    </div>

    <div class="gallery-grid">
      {POEM_PHOTOS.map((p) => (
        <button type="button" class="gallery-item" data-lightbox-src={p.img} data-lightbox-alt={p.alt} aria-label={`View larger: ${p.alt}`}>
          <img src={p.img} alt={p.alt} />
        </button>
      ))}
    </div>

    <div class="digital">
      <div class="poster-wrap">
        <div class="poster">
          <div class="caveat poster-hey">a poem for two</div>
          <h4>Between Two</h4>
          <div class="poster-divider"><span class="line"></span><span class="fleuron">❦</span><span class="line"></span></div>
          <div class="poster-poem">
            {POEM_LINES.map((line, i) => (
              <Fragment>{line}{i < POEM_LINES.length - 1 && <br />}</Fragment>
            ))}
          </div>
          <div class="poster-mark">poetry by mjs</div>
        </div>
        <div class="poster-badge">Digital edition</div>
      </div>
      <div>
        <div class="eyebrow eyebrow--on-dark digital-eyebrow">Paper, or pixels</div>
        <h3>Prefer it <span class="em-light">digital?</span></h3>
        <p class="custom-p">Not every poem needs to arrive in the mail. Choose a digital edition and I'll design your custom poem into a beautiful, print-ready file — delivered straight to your inbox, ready to share, post, or print and frame yourself. Same original words, instant delivery.</p>
        <div class="bullets">
          <div><i>✦</i> A designed, high-resolution digital file</div>
          <div><i>✦</i> Personalized with names, dates &amp; details</div>
          <div><i>✦</i> Delivered fast — perfect for last-minute gifts</div>
        </div>
        <a href={ETSY_LISTING} target="_blank" rel="noopener" class="btn-cream">Order a digital poem →</a>
      </div>
    </div>
  </section>

  <section class="goods">
    <div class="goods-inner">
      <div class="goods-head">
        <div>
          <div class="caveat goods-hey">poetry you can hold</div>
          <h2>Goods from the <span class="shop-em">Etsy shop</span></h2>
          <p>Favorite lines from <em>to be loved by a poet</em>, printed on things made for everyday moments.</p>
        </div>
        <div class="goods-controls">
          <a href={ETSY_SHOP} target="_blank" rel="noopener">Visit the shop →</a>
          <div class="goods-arrows">
            <button data-goods-scroll="-1" aria-label="Previous products">←</button>
            <button data-goods-scroll="1" aria-label="Next products">→</button>
          </div>
        </div>
      </div>
      <div data-goods-carousel class="goods-track">
        {ETSY_GOODS.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="product-card">
            <div class="product-img">
              <img src={p.img} alt={p.alt} loading="lazy" />
            </div>
            <div class="product-body">
              <div class="product-tag">{p.tag}</div>
              <h3>{p.name}</h3>
              <div class="product-detail">{p.detail}</div>
              <div class="product-foot">
                <span class="product-price">{p.price}</span>
                <span class="product-cta">View on Etsy →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="coming-soon">
    <div class="coming-head">
      <div class="coming-pill">Coming soon</div>
      <h2>Poetry <span class="shop-em">prints</span>, coming to Etsy</h2>
      <p>I'm putting the finishing touches on a collection of custom art prints — my poems, hand-set and designed to hang on your wall. Follow along and you'll know the moment they drop.</p>
    </div>
    <div class="coming-ctas">
      <a href="https://www.instagram.com/poetrybymjs/" target="_blank" rel="noopener" class="btn btn--accent">Follow on Instagram →</a>
      <a href={ETSY_LISTING} target="_blank" rel="noopener" class="link-underline">Visit my Etsy shop</a>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .shop-header {
    text-align: center;
    padding: clamp(56px, 8vw, 104px) 40px clamp(40px, 5vw, 64px);
    animation: floatUp 0.8s ease both;
  }
  .shop-hey { font-size: 28px; margin-bottom: 6px; }
  .shop-header h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(46px, 6.5vw, 86px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .shop-em { font-style: italic; color: var(--accent-deep); }
  .shop-header p { font-size: 18.5px; line-height: 1.65; color: var(--ink-soft); max-width: 52ch; margin: 0 auto; }

  .custom-dark { background: var(--surface-dark); color: var(--on-dark); padding: var(--pad-section); }
  .custom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
  }
  .custom-photo { position: relative; justify-self: center; max-width: 460px; }
  .custom-photo img { width: 100%; border-radius: 10px; box-shadow: 0 26px 60px rgba(0, 0, 0, 0.4); display: block; }
  .custom-tag {
    position: absolute;
    bottom: -16px;
    left: -18px;
    background: var(--accent-light);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 9px 16px;
    border-radius: 100px;
  }
  .made-to-order { margin-bottom: 16px; }
  .custom-dark h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .em-light { font-style: italic; color: var(--accent-light); }
  .custom-p { font-size: 17px; line-height: 1.72; color: var(--on-dark-soft); max-width: 52ch; margin-bottom: 30px; }
  .btn-light {
    display: inline-block;
    background: var(--accent-light);
    color: var(--ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    padding: 15px 32px;
    border-radius: 100px;
    transition: background 0.25s ease;
  }
  .btn-light:hover { background: var(--bg-paper); }
  .btn-cream {
    display: inline-block;
    background: var(--bg-paper);
    color: var(--ink);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    padding: 15px 30px;
    border-radius: 100px;
    transition: background 0.25s ease;
  }
  .btn-cream:hover { background: var(--accent-light); }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.6vw, 20px);
    max-width: 1180px;
    margin: clamp(40px, 5vw, 60px) auto 0;
  }
  .gallery-item {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
    width: 100%;
  }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .gallery-item:hover img { transform: scale(1.05); }

  .digital {
    max-width: 1180px;
    margin: clamp(44px, 5vw, 64px) auto 0;
    border-top: 1px solid rgba(246, 238, 227, 0.14);
    padding-top: clamp(40px, 5vw, 56px);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .poster-wrap { justify-self: center; max-width: 370px; width: 100%; position: relative; }
  .poster {
    background: var(--surface-cream);
    border: 1px solid rgba(44, 35, 32, 0.1);
    border-radius: 8px;
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.5);
    padding: clamp(30px, 4vw, 46px) clamp(26px, 3.4vw, 40px);
    transform: rotate(-1.4deg);
  }
  .poster-hey { font-size: 23px; text-align: center; transform: rotate(-2deg); display: block; }
  .poster h4 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(30px, 4vw, 38px);
    line-height: 1;
    text-align: center;
    color: var(--ink);
    margin: 10px 0 14px;
  }
  .poster-divider { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 22px; }
  .poster-divider .line { height: 1px; width: 44px; background: var(--accent); opacity: 0.5; }
  .fleuron { color: var(--accent); font-size: 15px; }
  .poster-poem { font-family: var(--font-serif); font-size: 13.5px; line-height: 1.95; text-align: center; color: var(--ink-soft-3); }
  .poster-mark {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-faint);
    margin-top: 20px;
  }
  .poster-badge {
    position: absolute;
    top: -14px;
    right: -14px;
    background: var(--accent-light);
    color: var(--ink);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 15px;
    border-radius: 100px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
    z-index: 2;
  }
  .digital-eyebrow { margin-bottom: 14px; }
  .digital h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .bullets { display: flex; flex-direction: column; gap: 11px; margin-bottom: 30px; }
  .bullets div { display: flex; align-items: center; gap: 12px; font-size: 16px; color: var(--on-dark); }
  .bullets i { color: var(--accent-light); font-style: normal; font-size: 15px; }

  .goods { padding: clamp(52px, 7vw, 92px) var(--pad-x); }
  .goods-inner { max-width: 1180px; margin: 0 auto; }
  .goods-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }
  .goods-hey { font-size: 26px; margin-bottom: 4px; }
  .goods-head h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .goods-head p { font-size: 17px; line-height: 1.65; color: var(--ink-soft); max-width: 46ch; }
  .goods-controls { display: flex; align-items: center; gap: 16px; padding-bottom: 6px; }
  .goods-controls > a { color: var(--accent); text-decoration: none; font-size: 14.5px; font-weight: 600; }
  .goods-arrows { display: flex; gap: 8px; }
  .goods-arrows button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(44, 35, 32, 0.2);
    background: var(--bg-paper);
    color: var(--ink);
    cursor: pointer;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .goods-arrows button:hover { background: var(--ink); color: var(--bg-paper); border-color: var(--ink); }
  .goods-track {
    display: flex;
    gap: clamp(16px, 2vw, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 6px;
  }
  .product-card {
    flex: 0 0 auto;
    width: clamp(250px, 30vw, 350px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface-card);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(44, 35, 32, 0.1);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .product-card:hover { box-shadow: 0 16px 36px rgba(44, 35, 32, 0.18); transform: translateY(-4px); }
  .product-img { aspect-ratio: 1 / 1; overflow: hidden; background: #fff; }
  .product-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .product-card:hover .product-img img { transform: scale(1.04); }
  .product-body { padding: 16px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .product-tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 7px;
  }
  .product-body h3 { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 21px; line-height: 1.18; margin-bottom: 6px; }
  .product-detail { font-size: 13px; color: var(--muted); margin-bottom: 16px; }
  .product-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; }
  .product-price { font-size: 15.5px; font-weight: 700; }
  .product-cta { color: var(--accent); font-size: 13.5px; font-weight: 600; }

  .coming-soon { background: var(--bg-paper-deep); padding: clamp(56px, 8vw, 100px) var(--pad-x); }
  .coming-head { max-width: 1180px; margin: 0 auto; text-align: center; }
  .coming-pill {
    display: inline-block;
    background: var(--accent);
    color: var(--bg-paper);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .coming-head h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .coming-head p { font-size: 18px; line-height: 1.65; color: var(--ink-soft); max-width: 52ch; margin: 0 auto 44px; }
  .coming-ctas { display: flex; align-items: center; justify-content: center; gap: 22px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .custom-grid, .digital { grid-template-columns: 1fr; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .product-card { width: min(78vw, 320px); }
  }
</style>

<script>
  const goodsTrack = document.querySelector<HTMLElement>('[data-goods-carousel]');
  document.querySelectorAll<HTMLButtonElement>('[data-goods-scroll]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!goodsTrack) return;
      const dir = Number(btn.dataset.goodsScroll);
      const step = Math.min(370, goodsTrack.clientWidth * 0.9);
      goodsTrack.scrollBy({ left: dir * step, behavior: 'smooth' });
    });
  });
</script>

